<?xml version="1.0" encoding="utf-8"?>
<!--
  FileProvider paths for image_picker camera capture.

  cache-path: maps to context.getCacheDir() — image_picker drops the
  captured JPEG here so we hand the OS camera intent a content:// URI
  it can write to without needing legacy storage permissions.

  files-path / external-files-path are also exposed so that any future
  upload flow (e.g. file_picker writing temp PDFs / docs / shared
  receipts) can reuse the same authority without another manifest edit.
-->
<paths>
    <cache-path name="my_images" path="."/>
    <files-path name="my_files" path="."/>
    <external-files-path name="external_files" path="."/>
    <external-path name="external" path="."/>
</paths>
