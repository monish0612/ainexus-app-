<?xml version="1.0" encoding="utf-8"?>
<!--
  FileProvider paths for camera / share URIs.

  cache-path: maps to context.getCacheDir() — image_picker and hold-to-speak
  drop temp media here. Kept at "." because the cache dir is app-private
  and already short-lived.

  files-path / external-files-path / external-path were previously "." which
  exposed the whole files dir (including the Drift DB) and shared external
  storage. No Dart/Kotlin caller uses getExternalStorageDirectory or this
  authority for those roots, so they are not declared.
-->
<paths>
    <cache-path name="my_images" path="."/>
</paths>
