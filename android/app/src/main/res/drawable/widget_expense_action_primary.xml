<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#2563EB"
                android:endColor="#7C3AED" />
            <corners android:radius="@dimen/widget_pill_radius" />
        </shape>
    </item>
    <item
        android:gravity="top"
        android:height="12dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#33FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners
                android:topLeftRadius="@dimen/widget_pill_radius"
                android:topRightRadius="@dimen/widget_pill_radius" />
        </shape>
    </item>
</layer-list>
