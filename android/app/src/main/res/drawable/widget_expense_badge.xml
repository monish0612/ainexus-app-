<?xml version="1.0" encoding="utf-8"?>
<!-- Empty-state icon badge: the app's signature AI gradient (indigo → violet)
     in a soft squircle, so the empty "getting started" panel reads as
     intentional and premium rather than blank. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="135"
        android:startColor="#6366F1"
        android:endColor="#A855F7" />
    <corners android:radius="13dp" />
</shape>
