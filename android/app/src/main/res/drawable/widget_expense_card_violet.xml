<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#1A1428"
                android:endColor="#0A0A10" />
            <stroke
                android:width="1dp"
                android:color="#33301A48" />
            <corners android:radius="@dimen/widget_inner_radius" />
        </shape>
    </item>
    <item
        android:gravity="top"
        android:height="16dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#1AA78BFA"
                android:endColor="#00A78BFA" />
            <corners
                android:topLeftRadius="@dimen/widget_inner_radius"
                android:topRightRadius="@dimen/widget_inner_radius" />
        </shape>
    </item>
</layer-list>
