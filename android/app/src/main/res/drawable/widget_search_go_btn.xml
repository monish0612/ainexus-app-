<?xml version="1.0" encoding="utf-8"?>
<!-- Trailing "go" button: a circular indigo → cyan gradient that reads as the
     action affordance on the right edge of the web search bar. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:angle="45"
        android:startColor="#6366F1"
        android:endColor="#22D3EE" />
</shape>
