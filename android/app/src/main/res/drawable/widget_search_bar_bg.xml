<?xml version="1.0" encoding="utf-8"?>
<!-- True capsule: radius = half of the 44dp bar. Hairline only — no sheen
     slab, so the widget reads as a search box instead of a thick card. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#F21A1A22" />
    <corners android:radius="@dimen/widget_search_bar_radius" />
    <stroke
        android:width="1dp"
        android:color="#3D3D4A" />
</shape>
