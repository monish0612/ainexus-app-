<?xml version="1.0" encoding="utf-8"?>
<!-- Inner search pill: a slightly lifted dark capsule with a subtle
     indigo-tinted border so it glows against the AMOLED card. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#121218"
        android:endColor="#0B0B11" />
    <corners android:radius="26dp" />
    <stroke
        android:width="1dp"
        android:color="#2B2B45" />
</shape>
