<?xml version="1.0" encoding="utf-8"?>
<!-- Outer AMOLED card: near-pure black with a whisper of vertical lift and a
     hairline border so the widget reads as a floating glass panel on the
     home screen. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#0A0A0F"
        android:endColor="#000000" />
    <corners android:radius="30dp" />
    <stroke
        android:width="1dp"
        android:color="#191926" />
</shape>
