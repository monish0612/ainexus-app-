<?xml version="1.0" encoding="utf-8"?>
<!-- Slim search capsule (44dp), not a filled 4x1 card.
     Outer frame stays transparent and is the sole tap target
     (id/widget_search_root). Do not rename load-bearing IDs. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_search_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_search_bar_height"
        android:layout_gravity="center"
        android:background="@drawable/widget_search_bar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/widget_search_globe"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/widget_search_label"
            android:src="@drawable/ic_widget_globe"
            android:tint="#8B93FF" />

        <TextView
            android:id="@+id/widget_search_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_search_hint_web"
            android:textColor="#8B93A7"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/widget_search_go"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/shortcut_search"
            android:src="@drawable/ic_widget_search"
            android:tint="#C5CAD6" />
    </LinearLayout>
</FrameLayout>
