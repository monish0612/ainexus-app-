# Nexus AI — Caddy 2 production configuration
#
# Serves the compiled Flutter web bundle (placed at /srv by the Dockerfile)
# with all the headers required for a modern PWA + Drift's sqlite3.wasm.
#
# Behind Coolify, the application's "Internal Port" (Ports Exposes) is 3000
# (Coolify's default). Coolify's proxy terminates TLS and forwards HTTP(S)
# traffic here over the `coolify` Docker network.

{
	# Globals
	admin off
	auto_https off
	servers {
		# Trust Coolify's reverse-proxy headers (X-Forwarded-For, etc).
		trusted_proxies static 0.0.0.0/0 ::/0
	}
}

:3000 {
	root * /srv
	encode zstd gzip

	# ── Health endpoint for container orchestration ─────────────────────────
	@healthz path /healthz
	respond @healthz "ok" 200

	# ── Long cache for content-hashed Flutter assets ────────────────────────
	# Anything under /assets/, /canvaskit/, /icons/, /fonts/, plus the
	# generated *.dart.js / .json bundles, is fingerprinted by `flutter
	# build web` and safe to cache forever.
	@hashed {
		path /assets/* /canvaskit/* /icons/* /fonts/*
		path *.js *.wasm *.json *.png *.svg *.woff2 *.ttf
	}
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# ── Short cache for index.html / manifest / service-worker ─────────────
	# These files change every release; we want browsers to revalidate.
	@noCacheRoot {
		path /index.html
		path /manifest.json
		path /flutter_service_worker.js
		path /version.json
		path /
	}
	header @noCacheRoot Cache-Control "no-cache, no-store, must-revalidate"

	# ── Security headers ────────────────────────────────────────────────────
	# We do NOT set Cross-Origin-Embedder-Policy: require-corp because Flutter
	# Web loads CanvasKit from https://www.gstatic.com which does not send
	# Cross-Origin-Resource-Policy. Without COEP we lose SharedArrayBuffer,
	# so Drift's sqlite3.wasm transparently falls back from OPFS to IndexedDB
	# — still fully functional, just slightly slower on bulk writes.
	header {
		# Standard hardening.
		X-Content-Type-Options       "nosniff"
		X-Frame-Options              "SAMEORIGIN"
		Referrer-Policy              "strict-origin-when-cross-origin"
		Permissions-Policy           "camera=(self), microphone=(self), geolocation=(), interest-cohort=()"

		# Permissive CSP tailored to Flutter Web. Flutter dynamically imports
		# JS chunks, loads CanvasKit/Skwasm WASM from gstatic.com, and pulls
		# fonts from Google Fonts. We list both `*-src` and `*-src-elem` so
		# strict browsers (which fall back to `default-src` for `*-src-elem`)
		# don't block resources. Kept on a single line because Caddy ships
		# the literal value (no line-continuation processing in `header`).
		Content-Security-Policy "default-src 'self' https: data: blob:; script-src 'self' 'wasm-unsafe-eval' 'unsafe-inline' https:; script-src-elem 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https:; style-src-elem 'self' 'unsafe-inline' https:; font-src 'self' https: data:; img-src 'self' data: blob: https:; connect-src 'self' https: http: ws: wss: data: blob:; worker-src 'self' blob:; child-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"

		# Drop the `Server: Caddy` banner.
		-Server
	}

	# ── sqlite3.wasm needs application/wasm Content-Type ────────────────────
	# Caddy already infers this from the .wasm extension, but be explicit.
	@wasm path *.wasm
	header @wasm Content-Type "application/wasm"

	# ── SPA fallback ─────────────────────────────────────────────────────────
	# Any path that doesn't match a real file falls through to /index.html
	# so GoRouter can handle deep links like /#/login, /#/landing, etc.
	try_files {path} {path}/ /index.html

	file_server {
		# Don't expose directory listings.
		hide .git .htaccess
	}

	# ── Logging ──────────────────────────────────────────────────────────────
	log {
		output stdout
		format console
		level INFO
	}
}
